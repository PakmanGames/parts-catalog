{
  "name": "parts-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm compose up --detach --wait && pnpm db:migrate && next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "compose": "docker compose --env-file .env $([ -f .env.local ] && echo --env-file .env.local)",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/db/migrate.ts",
    "import:csv": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "9.2.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "railway": "3.13.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
